# ==============================================================================
# EchoAgent: n8n Production Environment Configuration Template
# For Render Web Service (Root Directory: n8n, Docker runtime)
# ==============================================================================

# General
NODE_ENV=production
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://your-render-service.onrender.com/
N8N_REST_CORS_ALLOWED_ORIGINS=*

# Execution Data Retention
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=24

# Supabase Managed PostgreSQL Database Connection
DB_TYPE=postgresdb
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=postgres.your_project_ref
DB_POSTGRESDB_PASSWORD=your_supabase_db_password
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# LLM & Delivery Channel Credentials
GROQ_API_KEY=your_groq_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
